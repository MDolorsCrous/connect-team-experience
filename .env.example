# ---- Navegador (públiques: Vite les incrusta al bundle) ----
# URL i clau "anon"/publishable del projecte Supabase. La clau anon és pública
# per disseny: la seguretat la donen les polítiques RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Slug de l'experiència que mostra la landing
VITE_EXPERIENCE_SLUG=connect-christmas-2026

# ---- Servidor (NOMÉS a Netlify → Site settings → Environment variables) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cadena aleatòria llarga; serveix per guardar la IP com a hash, mai en clar
IP_HASH_SALT=
# Orígens permesos per al formulari (separats per comes)
ALLOWED_ORIGINS=https://connect-christmas.impausa.com
# URL pública del web (enllaç al panell als correus interns)
PUBLIC_SITE_URL=https://connect-christmas.impausa.com

# Correu transaccional: "resend" en producció, "log" en desenvolupament
EMAIL_PROVIDER=log
RESEND_API_KEY=
# Remitent verificat al proveïdor, p. ex. "IMPAUSA <reserves@impausa.com>"
EMAIL_FROM=

# Dades de contacte que surten als correus (per defecte, les del catàleg)
CONTACT_LEGAL_NAME=IMPAUSA POWER S.L.
CONTACT_EMAIL=hola@impausa.com
CONTACT_PHONE=613 026 544
CONTACT_WEB=https://www.impausa.com
